---
import Base from '../layouts/Base.astro';
import { person, data, sections, isLive, locationLabel, SITE_URL, IS_PLACEHOLDER_DOMAIN, clip, link } from '../data/site';

const lead =
  data.profile.description ||
  `${person.name} is based in ${locationLabel}. This is the official website, where verified details are published section by section.`;

const title = `${person.name} — Official Website`;
const description = clip(
  data.profile.description
    ? `Official website of ${person.name}, based in ${locationLabel}. ${data.profile.description}`
    : `The official website of ${person.name}, based in ${locationLabel}. Verified profile, links and contact details in one place.`,
);

const host = SITE_URL.replace(/^https?:\/\//, '');
const index = [
  ...sections.map((s) => ({ label: s.label, blurb: s.blurb, href: link(`/${s.slug}/`), live: isLive(s.key) })),
  { label: 'Contact', blurb: 'The verified way to get in touch.', href: link('/contact/'), live: true },
];
const n = (i: number) => String(i + 1).padStart(2, '0');
---
<Base {title} heading={person.name} {description} path="/" kind="profile">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow"><span class="dot" aria-hidden="true"></span> Official website</p>
      <h1 class="display"><span class="l1">Benjamin</span> <span class="l2">Anthony</span> <span class="l3">Panakal</span></h1>

      <div class="hero-grid">
        <div class="hero-meta">
          <ul class="chips" aria-label="Quick facts">
            <li>
              <span class="chip">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M8 14.5s5-4.1 5-8a5 5 0 1 0-10 0c0 3.9 5 8 5 8Z"/><circle cx="8" cy="6.5" r="1.8"/></svg>
                {locationLabel}
              </span>
            </li>
            {person.profiles.map((p) => (
              <li>
                <a class="chip" href={p.url} rel="me noopener" target="_blank">
                  {p.label} <span class="visually-hidden">(opens in a new tab)</span>
                  <svg class="arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5"/></svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <p class="lead hero-lead">{lead}</p>
      </div>
    </div>
  </section>

  <div class="beam" aria-hidden="true"></div>

  <section class="section reveal" aria-labelledby="who">
    <div class="wrap split">
      <div class="side">
        <p class="eyebrow">At a glance</p>
        <h2 class="h2" id="who">Who is {person.name}?</h2>
        <p class="muted">The facts below are the ones confirmed by the site owner. Nothing is added from guesswork.</p>
      </div>
      <div class="main">
        <dl class="facts">
          <div class="row"><dt>Full name</dt><dd>{person.name}</dd></div>
          <div class="row"><dt>Based in</dt><dd>{locationLabel}</dd></div>
          {data.profile.jobTitle && <div class="row"><dt>Occupation</dt><dd>{data.profile.jobTitle}</dd></div>}
          {person.profiles.map((p) => (
            <div class="row"><dt>{p.label}</dt><dd><a href={p.url} rel="me noopener" target="_blank">{p.handle}</a></dd></div>
          ))}
          {!IS_PLACEHOLDER_DOMAIN && <div class="row"><dt>Website</dt><dd>{host}</dd></div>}
        </dl>
      </div>
    </div>
  </section>

  <section class="section reveal" aria-labelledby="explore">
    <div class="wrap split">
      <div class="side">
        <p class="eyebrow">Index</p>
        <h2 class="h2" id="explore">Explore the site</h2>
        <p class="muted">A section goes live once its details are verified, so every page here holds real content.</p>
      </div>
      <div class="main">
        <ol class="index">
          {index.map((it, i) => (
            <li>
              {it.live ? (
                <a class="item" href={it.href}>
                  <span class="num" aria-hidden="true">{n(i)}</span>
                  <span class="name">{it.label}</span>
                  <svg class="go" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
                  <span class="desc">{it.blurb}</span>
                </a>
              ) : (
                <div class="item soon">
                  <span class="num" aria-hidden="true">{n(i)}</span>
                  <span class="name">{it.label}</span>
                  <span class="tag">In preparation</span>
                  <span class="desc">{it.blurb}</span>
                </div>
              )}
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
</Base>
