---
import '../styles/global.css';
import { PREVIEW, data, person, liveSections, url, link, formatDate, locationLabel } from '../data/site';
import { buildGraph, type PageKind } from '../lib/schema';

interface Props {
  title: string;                 // full <title>
  heading: string;               // short name used in structured data
  description: string;
  path: string;                  // "/" or "/biography/"
  kind?: PageKind;
  noindex?: boolean;
  breadcrumbs?: { name: string; path: string }[];
  extraNodes?: Record<string, unknown>[];
  atmos?: boolean;
}

const { title, heading, description, path, kind = 'webpage', noindex = false, breadcrumbs, extraNodes = [], atmos = true } = Astro.props;

const canonical = url(path);
const robots = noindex || PREVIEW
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const photo = data.profile.photo;
const ogImage = photo ? url(photo.src) : url('/og/default.png');
const ogAlt = photo ? photo.alt : `${person.name} — official website`;

const graph = buildGraph({ kind, path, name: heading, description, breadcrumbs, ogImage });
(graph['@graph'] as unknown[]).push(...extraNodes);
const jsonLd = JSON.stringify(graph).replace(/</g, '\\u003c');

const navItems = [
  ...liveSections.map((s) => ({ label: s.label, href: link(`/${s.slug}/`) })),
  { label: 'Contact', href: link('/contact/') },
];
const collapsible = navItems.length > 3;
const isCurrent = (href: string) => Astro.url.pathname === href;
const isOg = kind === 'profile';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="author" content={person.name} />
    <meta name="theme-color" content="#08090a" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href={link('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={link('/apple-touch-icon.png')} />
    {person.profiles.map((p) => <link rel="me" href={p.url} />)}

    <meta property="og:site_name" content={person.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:type" content={isOg ? 'profile' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogAlt} />
    {!photo && <meta property="og:image:width" content="1200" />}
    {!photo && <meta property="og:image:height" content="630" />}
    {isOg && <meta property="profile:first_name" content={person.givenName} />}
    {isOg && <meta property="profile:last_name" content={person.familyName} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <link rel="preload" href={link('/fonts/inter-latin-wght-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={link('/fonts/instrument-serif-latin-400-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={link('/fonts/instrument-serif-latin-400-italic.woff2')} as="font" type="font/woff2" crossorigin />

    <script is:inline>document.documentElement.classList.add('js')</script>
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {PREVIEW && <div class="preview-banner">DESIGN PREVIEW — sample content only. Not real information. Not indexable.</div>}

    <header class={`site-header${collapsible ? ' has-menu' : ''}`}>
      <div class="wrap">
        <a class="brand" href={link('/')} aria-label={`${person.name} — home`}>
          <span class="brand-mark" aria-hidden="true">B</span>
          <span>{person.name}</span>
        </a>
        {collapsible && (
          <button class="menu-btn" type="button" aria-expanded="false" aria-controls="primary-nav">
            <span class="bars" aria-hidden="true"></span>
            <span>Menu</span>
          </button>
        )}
        <nav class="nav" id="primary-nav" aria-label="Primary" data-open="false">
          {navItems.map((n) => (
            <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <div class={atmos ? 'atmos' : undefined}>
      <main id="main">
        <slot />
      </main>
    </div>

    <footer class="site-footer">
      <div class="wrap">
        <div class="foot">
          <div>
            <p class="who">{person.name}</p>
            <p class="small">Official website. Based in {locationLabel}.</p>
          </div>
          <nav aria-label="Site">
            <h2>Explore</h2>
            <ul>
              <li><a href={link('/')}>Home</a></li>
              {navItems.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
            </ul>
          </nav>
          <div>
            <h2>Elsewhere</h2>
            <ul>
              {person.profiles.map((p) => (
                <li><a href={p.url} rel="me noopener" target="_blank">{p.label} <span class="visually-hidden">(opens in a new tab)</span><span aria-hidden="true">↗</span></a></li>
              ))}
            </ul>
          </div>
        </div>
        <div class="legal">
          <span>© {new Date().getFullYear()} {person.name}</span>
          <span>Last reviewed <time datetime={data.lastReviewed}>{formatDate(data.lastReviewed)}</time></span>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var btn = document.querySelector('.menu-btn');
        var nav = document.getElementById('primary-nav');
        if (btn && nav) {
          btn.addEventListener('click', function () {
            var open = btn.getAttribute('aria-expanded') === 'true';
            btn.setAttribute('aria-expanded', String(!open));
            nav.setAttribute('data-open', String(!open));
          });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { btn.click(); btn.focus(); }
          });
        }
        if (window.matchMedia('(hover: hover)').matches) {
          document.addEventListener('pointermove', function (e) {
            var c = e.target.closest && e.target.closest('.card');
            if (!c) return;
            var r = c.getBoundingClientRect();
            c.style.setProperty('--mx', e.clientX - r.left + 'px');
            c.style.setProperty('--my', e.clientY - r.top + 'px');
          }, { passive: true });
        }
      })();
    </script>
  </body>
</html>
